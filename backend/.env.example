NODE_ENV=development
PORT=4000
# MySQL connection string. With scripts/dev-mysql.sh the defaults below work as-is.
DATABASE_URL="mysql://school:school_pass@127.0.0.1:3307/school_db"
# Separate database used by `npm test` (it is reset by the tests).
TEST_DATABASE_URL="mysql://school:school_pass@127.0.0.1:3307/school_test"
# Use long random strings in production: `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Frontend origin allowed by CORS (comma-separated for several)
CORS_ORIGIN=http://localhost:3000
# Public URL of the frontend, used in password reset links
APP_URL=http://localhost:3000
# Set to true behind HTTPS so cookies get the Secure flag
COOKIE_SECURE=false
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
LOG_LEVEL=info
# Optional SMTP; if unset, password reset links are logged to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="School <no-reply@school.rw>"
# Reverse proxies in front of the API. 1 = Next.js rewrite only. Put nginx/Traefik in front in
# production and set this to the number of hops so rate limits use the real client IP.
TRUST_PROXY=1
# Max login attempts per IP per 15 minutes (per-account lockout after 5 failures applies separately)
LOGIN_RATE_LIMIT=10
